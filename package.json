{
  "name": "open-swagger-ui",
  "version": "1.3.0",
  "description": "An easy CLI to open swagger(.json or .yaml) files in Swagger UI",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "open-swagger-ui": "./dist/bin/open-swagger-ui.cjs"
  },
  "files": [
    "dist/**/*",
    "!dist/**/*.map"
  ],
  "directories": {
    "test": "tests",
    "lib": "dist"
  },
  "scripts": {
    "build": "tsdown",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "npm run build && vitest run --coverage",
    "test:compat": "node scripts/test-compat.cjs",
    "test:docker": "bash scripts/test-docker.sh",
    "prepublishOnly": "npm run test && npm run test:compat",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format": "prettier --check \"src/**/*.{ts,js,json}\" \"tests/**/*.{ts,js,json}\"",
    "format:fix": "prettier --write \"src/**/*.{ts,js,json}\" \"tests/**/*.{ts,js,json}\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vajahath/open-swagger-ui.git"
  },
  "engines": {
    "node": ">=10"
  },
  "author": "Vajahath Ahmed <vajuoff.1@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/vajahath/open-swagger-ui/issues"
  },
  "homepage": "https://github.com/vajahath/open-swagger-ui#readme",
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/is-url": "^1.2.32",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash.isplainobject": "^4.0.9",
    "@types/node": "^20.17.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/update-notifier": "^5.1.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsdown": "latest",
    "typescript": "^7.0.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "commander": "^11.1.0",
    "express": "^4.21.2",
    "get-port": "^5.1.1",
    "got": "^11.8.6",
    "is-url": "^1.2.4",
    "js-yaml": "^4.3.2",
    "lodash.isplainobject": "^4.0.6",
    "open": "^8.4.2",
    "ora": "^5.4.1",
    "swagger-ui-express": "^5.0.1",
    "upath": "^2.0.1",
    "update-notifier": "^5.1.0"
  }
}
